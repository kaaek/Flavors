# https://editorconfig.org — keeps formatting consistent across editors and OSes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,css,html,md}]
indent_size = 2

# Trailing double spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
